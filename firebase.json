{
  "database": [
    {
      "instance": "pmv1-90180-default-rtdb",
      "rules": "database.rules.json"
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "rules": "src/firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "pmv1",
      "rules": "src/firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
 "functions": {
    "source": "src/functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/lineWebhook",
        "function": {
          "functionId": "lineWebhookV2",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/horoscope",
        "function": {
          "functionId": "horoscopeDaily",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/exam-pdf",
        "function": {
          "functionId": "examPdfBytes",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/device-fingerprint",
        "function": {
          "functionId": "deviceFingerprintAttendance",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
