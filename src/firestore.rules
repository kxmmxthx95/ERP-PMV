rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isAuth() && data != null && data.role == role;
    }

    function isSuperAdmin() {
      return isAuth() && (request.auth.token.email == 'sysadmin@pmv.com' || hasRole('sysadmin'));
    }

    function canManage() {
      return isSuperAdmin() || hasRole('admin') || hasRole('teacher');
    }

    function isStudentRole() {
      return isAuth() && hasRole('student');
    }

    // นักเรียนแก้โปรไฟล์ตัวเอง — รองรับ doc id ไม่ตรง auth uid (resolve ด้วย email / studentCode)
    function ownsStudentRecord(studentId) {
      let user = getUserData();
      return isAuth() && (
        studentId == request.auth.uid
        || resource.data.authUid == request.auth.uid
        || resource.data.userId == request.auth.uid
        || (
          user != null
          && user.keys().hasAny(['studentCode'])
          && resource.data.studentCode == user.studentCode
        )
        || (
          request.auth.token.email != null
          && resource.data.keys().hasAny(['email'])
          && resource.data.email == request.auth.token.email
        )
      );
    }

    function studentSelfFieldsOnly() {
      let adminKeys = ['status', 'studentCode', 'createdAt'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminKeys);
    }

    // ── Global Rule ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if isAuth();
      allow write: if canManage();
    }

    // ── Users: อนุญาตให้แก้โปรไฟล์ตัวเองได้ ──────────────────────────────────
    match /users/{userId} {
      allow update: if isAuth() && userId == request.auth.uid
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('isActive' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Leave Requests: อนุญาตให้ยื่นคำขอลาได้เอง ──────────────────────────────
    match /leave_requests/{docId} {
      allow create: if isAuth() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAuth() && (
        canManage() 
        || (resource.data.requesterId == request.auth.uid && resource.data.status == 'pending')
      );
      allow delete: if isAuth() && (
        isSuperAdmin() 
        || (resource.data.requesterId == request.auth.uid && resource.data.status == 'pending')
      );
    }

    // ── PMV Voice (Student Feedback) ────────────────────────────────────────
    match /student_feedback/{feedbackId} {
      // นักเรียนส่ง feedback ได้เอง (2 โหมด)
      allow create: if isAuth() && (
        (
          request.resource.data.mode == 'identified' &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'new'
        ) ||
        (
          request.resource.data.mode == 'anonymous' &&
          !('studentId' in request.resource.data) &&
          request.resource.data.status == 'new'
        )
      );

      // ผู้ดูแลอัปเดตสถานะได้
      allow update: if isAuth() && canManage();
      allow delete: if isAuth() && isSuperAdmin();
    }

    // เก็บ limit สำหรับ anonymous (วันละ 1 ครั้ง) — ไม่เก็บ field studentId
    match /feedback_anonymous_limits/{limitId} {
      allow create: if isAuth()
        && limitId.matches('^' + request.auth.uid + '_.*$')
        && !exists(/databases/$(database)/documents/feedback_anonymous_limits/$(limitId));
      allow update, delete: if false;
    }

    // ── Staff Attendance ─────────────────────────────────────────────────────
    match /staff_attendance/{docId} {
      allow create: if isAuth() && (hasRole('staff') || hasRole('teacher'))
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid && (hasRole('staff') || hasRole('teacher')))
        || hasRole('admin') || isSuperAdmin()
      );
    }

    // ── Staff Attendance (New Shape: date -> entries/{userId}) ──────────────
    match /staff_attendance_by_date/{dateId} {
      // allow creating/updating per-day envelope document
      allow create, update: if isAuth() && (
        hasRole('admin') || isSuperAdmin()
        || (
          (hasRole('staff') || hasRole('teacher'))
          && request.resource.data.date == dateId
        )
      );
    }

    match /staff_attendance_by_date/{dateId}/entries/{userId} {
      allow create, update: if isAuth() && (
        hasRole('admin') || isSuperAdmin()
        || (
          (hasRole('staff') || hasRole('teacher'))
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.date == dateId
        )
      );
    }

    // ── Students ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow create, delete: if canManage();
      allow update: if canManage() || (
        isStudentRole()
        && ownsStudentRecord(studentId)
        && studentSelfFieldsOnly()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
    }

    // ── Student Future Plans ──────────────────────────────────────────────────
    // doc ID = studentId; นักเรียนเขียนเฉพาะ doc ของตัวเองได้
    match /student_future_plans/{studentId} {
      allow create, update: if isAuth() && studentId == request.auth.uid;
      allow delete: if isSuperAdmin() || hasRole('admin');
    }

    // ── Exam Attempts (sub-collection ใต้ exam_rooms) ───────────────────────
    match /exam_rooms/{roomId}/attempts/{attemptId} {
      // นักเรียนอ่านเฉพาะ attempt ของตัวเองได้
      allow read: if isAuth() && (canManage() || resource.data.studentId == request.auth.uid);
      allow list: if isAuth() && (canManage() || request.query.limit <= 100); // query จะถูกกรองด้วย where studentId ต่อไป

      // นักเรียนสร้าง attempt ของตัวเองได้
      allow create: if isAuth()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.score == null
        && request.resource.data.submittedAt == null;

      // นักเรียนอัปเดตได้เฉพาะ attempt ของตัวเอง (autosave + submit)
      // ห้ามแก้ score/round/startedAt/studentId — เฉพาะ answers, suspiciousActivities, status, submittedAt, lastSavedAt
      allow update: if isAuth()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.round == resource.data.round
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.score == resource.data.score
        && resource.data.status == 'in_progress'
        && (request.resource.data.status == 'in_progress' || request.resource.data.status == 'submitted')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'answers',
          'suspiciousActivities',
          'status',
          'submittedAt',
          'lastSavedAt'
        ]);

      // การลบให้เฉพาะผู้ดูแล
      allow delete: if hasRole('admin') || isSuperAdmin();
    }

    // ── Logs: allow all authenticated users to append usage logs ────────────
    match /logs/{logId} {
      allow create: if isAuth();
      allow update, delete: if hasRole('admin') || isSuperAdmin();
    }
  }
}
