{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "backfill:class-sessions": "npm run build && node lib/backfillClassSessions.js",
    "migrate:staff-attendance-by-date": "npm run build && node lib/migrateStaffAttendanceByDate.js",
    "migrate:staff-attendance-by-date:dry-run": "npm run build && node lib/migrateStaffAttendanceByDate.js --dry-run",
    "cleanup:staff-attendance-duplicates": "npm run build && node lib/cleanupStaffAttendanceDuplicates.js",
    "cleanup:staff-attendance-duplicates:dry-run": "npm run build && node lib/cleanupStaffAttendanceDuplicates.js --dry-run",
    "migrate:database": "npm run build && node lib/scripts/migrateDatabase.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.16.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
